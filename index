<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ada Yang Mau Aku Bilang...</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            overflow: hidden;
        }

        .container {
            text-align: center;
            padding: 40px;
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            max-width: 500px;
            width: 90%;
            position: relative;
            z-index: 10;
        }

        h1 {
            color: #667eea;
            font-size: 2.5em;
            margin-bottom: 20px;
            animation: fadeInDown 1s ease;
        }

        .message {
            font-size: 1.2em;
            color: #333;
            line-height: 1.6;
            margin: 20px 0;
            animation: fadeIn 1.5s ease;
        }

        .question {
            font-size: 1.5em;
            color: #764ba2;
            margin: 30px 0 20px 0;
            font-weight: bold;
            animation: fadeIn 2s ease;
        }

        .buttons {
            display: flex;
            gap: 20px;
            justify-content: center;
            margin-top: 30px;
            flex-wrap: wrap;
        }

        button {
            padding: 15px 40px;
            font-size: 1.1em;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: bold;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .btn-yes {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .btn-yes:hover {
            transform: scale(1.1);
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
        }

        .btn-no {
            background: #e0e0e0;
            color: #666;
            position: relative;
        }

        .btn-no:hover {
            background: #d0d0d0;
        }

        .hearts {
            position: fixed;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        .heart {
            position: absolute;
            font-size: 30px;
            animation: float 4s ease-in infinite;
            opacity: 0;
        }

        @keyframes float {
            0% {
                transform: translateY(100vh) rotate(0deg);
                opacity: 1;
            }
            100% {
                transform: translateY(-100vh) rotate(360deg);
                opacity: 0;
            }
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }

        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .celebration {
            display: none;
            font-size: 1.3em;
            color: #667eea;
            margin-top: 20px;
            animation: fadeIn 1s ease;
        }

        .hidden {
            display: none;
        }
    </style>
</head>
<body>
    <div class="hearts" id="hearts"></div>
    
    <div class="container">
        <div id="mainContent">
            <h1>Hai Cika! 💜</h1>
            <div class="message">
                Aku udah lama pengen bilang sesuatu ke kamu...<br><br>
                Setiap hari rasanya lebih berwarna kalau ada kamu.<br>
                Senyummu selalu bikin hariku jadi lebih baik.<br><br>
                Dan aku nggak bisa bohong lagi sama perasaan aku...
            </div>
            <div class="question">
                Aku suka sama kamu 💕
            </div>
            <div class="buttons">
                <button class="btn-yes" onclick="handleYes()">Aku juga suka kamu ❤️</button>
                <button class="btn-no" id="btnNo" onclick="handleNo()">Maaf, aku nggak bisa...</button>
            </div>
        </div>
        
        <div id="successMessage" class="hidden">
            <h1>🥹💕</h1>
            <div class="message">
                Terima kasih udah mau nerima perasaan aku...<br>
                Aku seneng banget bisa jujur sama kamu!<br><br>
                Aku nggak tau ini bakal kemana, tapi yang pasti...<br>
                <strong>Aku bahagia banget sekarang! 💖</strong>
            </div>
        </div>
    </div>

    <script>
        let noClickCount = 0;
        const noResponses = [
            "Yakin nggak bisa? 🥺",
            "Coba pikirkan lagi ya...",
            "Aku serius loh dengan perasaan aku 💜",
            "Nggak ada kesempatan sedikit pun? 😢",
            "Oke deh... aku terima keputusan kamu 💔"
        ];

        function handleNo() {
            const btnNo = document.getElementById('btnNo');
            noClickCount++;
            
            if (noClickCount < noResponses.length) {
                btnNo.textContent = noResponses[noClickCount];
                
                // Tombol "Nggak Mau" makin mengecil
                const newSize = Math.max(0.5, 1 - (noClickCount * 0.15));
                btnNo.style.transform = `scale(${newSize})`;
                
                // Tombol "Mau" makin membesar
                const btnYes = document.querySelector('.btn-yes');
                const yesSize = 1 + (noClickCount * 0.2);
                btnYes.style.transform = `scale(${yesSize})`;
            } else {
                // Tombol hilang setelah beberapa kali klik
                btnNo.style.display = 'none';
            }
        }

        function handleYes() {
            document.getElementById('mainContent').classList.add('hidden');
            document.getElementById('successMessage').classList.remove('hidden');
            
            // Buat hati berterbangan
            createHearts();
        }

        function createHearts() {
            const heartsContainer = document.getElementById('hearts');
            for (let i = 0; i < 30; i++) {
                setTimeout(() => {
                    const heart = document.createElement('div');
                    heart.className = 'heart';
                    heart.textContent = ['❤️', '💕', '💖', '💗', '💝'][Math.floor(Math.random() * 5)];
                    heart.style.left = Math.random() * 100 + '%';
                    heart.style.animationDelay = Math.random() * 2 + 's';
                    heart.style.animationDuration = (Math.random() * 3 + 3) + 's';
                    heartsContainer.appendChild(heart);
                    
                    setTimeout(() => heart.remove(), 7000);
                }, i * 100);
            }
        }
    </script>
</body>
</html>
